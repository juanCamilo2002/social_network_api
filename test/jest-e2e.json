{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest",
    "^.+\\.js$": [
      "babel-jest",
      {
        "presets": [
          [
            "@babel/preset-env",
            {
              "targets": {
                "node": "current"
              }
            }
          ]
        ],
        "plugins": [
          "./test/babel-rename-require.cjs",
          "babel-plugin-transform-import-meta"
        ]
      }
    ]
  },
  "transformIgnorePatterns": [
    "node_modules/(?!@nestjs/(jwt|config|typeorm)/)"
  ]
}